# SAFETYPRO AFRICA — environment configuration
# Protecting People. Powering Safety. — PPE | Workwear | Fire Safety | Industrial Safety | Fall Protection | Respiratory Protection | Safety Training | Workplace Compliance
# Copy to `.env` (production/local) and fill in real values. Never commit `.env`.

# ── Database ────────────────────────────────────────────────────────────────
# Production Postgres connection string (used by the app + Prisma migrations).
DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.safetypro.co.ke

# Seed credentials for the first superadmin account (created by the DB seed / first run).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# ── SMTP (Nodemailer) ────────────────────────────────────────────────────────
# All transactional email (invoices, quotes, tickets, alerts, newsletter) is
# sent through this SMTP server. Emails are AWAITED in handlers — on Vercel
# serverless an un-awaited send is frozen before it completes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-password
SMTP_FROM="SAFETYPRO AFRICA" <info@safetypro.co.ke>

# ── Payments: M-Pesa Daraja ──────────────────────────────────────────────────
MPESA_ENV=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=             # e.g. 174379 (sandbox)
# Used by the STK push initiation. NOTE: the live callback URL is registered in
# the Daraja portal, not here.
MPESA_CALLBACK_URL=https://www.safetypro.co.ke/api/payments/mpesa/callback
# Transaction Status API (receipt lookups for payments confirmed via the
# STK-query fallback). Required so blank transaction references auto-fill
# with the real M-Pesa receipt number (e.g. TB17CVOCY9) from Daraja.
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=

# ── Payments: Paystack ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx   # sk_live_xxx in production

# ── Canonical site URL ───────────────────────────────────────────────────────
# Where payment callbacks return. Defaults to https://www.safetypro.co.ke — set it
# explicitly for local dev (http://localhost:3000) or preview deployments,
# otherwise Paystack/M-Pesa redirect customers to PRODUCTION, whose database
# doesn't know your local orders.
NEXT_PUBLIC_SITE_URL=https://www.safetypro.co.ke

# ── Cron / daily digest ──────────────────────────────────────────────────────
# Required by the daily-orders cron (vercel.json). When set, Vercel injects
# `Authorization: Bearer $CRON_SECRET` on cron invocations and the endpoint
# rejects everything else.
CRON_SECRET=
DAILY_ORDERS_EMAIL=you@example.com

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-3X3CZ6B428

# ── Local image processing (optional, scripts/gen-product-images.cjs) ───────
PYTHON=python
